# dataset: ~6.4 GB of day CSVs, fetched with src/download.sh
data/*
!data/.gitkeep
# 200-row demo file for the dashboard and the demo video (68 KB), built from
# two day files by the snippet in README; committed so a fresh clone has
# something to upload without downloading 6.4 GB first
!data/demo_sample.csv

# large intermediates (GitHub rejects files over 100 MB)
models/clean.joblib
models/clean_*.joblib
models/*.log

# the trained model itself is small (0.2 MB) and IS committed, so the
# dashboard works straight after a clone:
!models/model.joblib
!models/metrics.json
!models/confusion_matrix.csv

.venv/
__pycache__/
*.pyc
.DS_Store
.streamlit/secrets.toml
